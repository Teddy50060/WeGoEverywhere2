@startuml 
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

rectangle "<<Application>>\nWeGoEveryWhere" as App

' ============================================================
' AUTH MODULE
' ============================================================

rectangle "<<Resource>>\nLogin\n+ POST" as Login
App --> Login : <<path>> /auth/login

rectangle "<<Resource>>\nRegister\n+ POST" as Register
App --> Register : <<path>> /auth/register

rectangle "<<Resource>>\nForgotPassword\n+ POST" as ForgotPassword
App --> ForgotPassword : <<path>> /auth/forgot-password

rectangle "<<Resource>>\nResetPassword\n+ POST" as ResetPassword
App --> ResetPassword : <<path>> /auth/reset-password

rectangle "<<Resource>>\nRefreshJwt\n+ POST" as RefreshJwt
App --> RefreshJwt : <<path>> /auth/refresh-jwt-token

rectangle "<<Resource>>\nLogout\n+ POST" as Logout
App --> Logout : <<path>> /auth/logout

rectangle "<<Resource>>\nLogoutAll\n+ POST" as LogoutAll
App --> LogoutAll : <<path>> /auth/logout-all

rectangle "<<Resource>>\nGithubAuth\n+ GET" as GithubAuth
App --> GithubAuth : <<path>> /auth/github

rectangle "<<Resource>>\nGithubCallback\n+ GET" as GithubCallback
App --> GithubCallback : <<path>> /auth/callback

rectangle "<<Resource>>\nRegisterOauth\n+ POST" as RegisterOauth
App --> RegisterOauth : <<path>> /auth/registerOauth

rectangle "<<Resource>>\nAuthMethod\n+ GET" as AuthMethod
App --> AuthMethod : <<path>> /auth/method


' ============================================================
' AUTH REPRESENTATIONS (FIXED)
' ============================================================

' ---------- AuthResponse (FIXED full structure) ----------
rectangle "<<Representation>>\nAuthResponse\n- accessToken\n- refreshToken\n- user.userId\n- user.firstName\n- user.lastName\n- user.email\n- user.profilePicture" as AuthResponse

Login --> AuthResponse : <<use>>
Register --> AuthResponse : <<use>>
GithubAuth --> AuthResponse : <<use>>
GithubCallback --> AuthResponse : <<use>>
RegisterOauth --> AuthResponse : <<use>>


' ---------- StatusResponse ----------
rectangle "<<Representation>>\nStatusResponse\n- message" as StatusResponse

ForgotPassword --> StatusResponse : <<use>>
ResetPassword --> StatusResponse : <<use>>
Logout --> StatusResponse : <<use>>
LogoutAll --> StatusResponse : <<use>>


' ---------- RefreshJwtResponse ----------
rectangle "<<Representation>>\nRefreshJwtResponse\n- accessToken" as RefreshJwtResponse

RefreshJwt --> RefreshJwtResponse : <<use>>


' ---------- MethodResponse ----------
rectangle "<<Representation>>\nMethodResponse\n- method" as MethodResponse

AuthMethod --> MethodResponse : <<use>>


' ============================================================
' CONSENT MODULE
' ============================================================

rectangle "<<Resource>>\nGetCurrentPolicy\n+ GET" as GetCurrentPolicy
App --> GetCurrentPolicy : <<path>> /api/consent/current-policy

rectangle "<<Resource>>\nCheckConsent\n+ GET" as CheckConsent
App --> CheckConsent : <<path>> /api/consent/check/{userId}

rectangle "<<Resource>>\nAcceptConsent\n+ POST" as AcceptConsent
App --> AcceptConsent : <<path>> /api/consent/accept

rectangle "<<Resource>>\nCreatePolicy\n+ POST" as CreatePolicy
App --> CreatePolicy : <<path>> /api/consent/admin/policy

rectangle "<<Resource>>\nPolicyHistory\n+ GET" as PolicyHistory
App --> PolicyHistory : <<path>> /api/consent/policies/history

rectangle "<<Resource>>\nGetPolicyByVersion\n+ GET" as GetPolicyByVersion
App --> GetPolicyByVersion : <<path>> /api/consent/policy/{version}

rectangle "<<Resource>>\nUpdatePolicy\n+ PUT" as UpdatePolicy
App --> UpdatePolicy : <<path>> /api/consent/admin/policy/{version}

rectangle "<<Resource>>\nDeletePolicy\n+ DELETE" as DeletePolicy
App --> DeletePolicy : <<path>> /api/consent/admin/policy/{version}

rectangle "<<Resource>>\nActivatePolicy\n+ POST" as ActivatePolicy
App --> ActivatePolicy : <<path>> /api/consent/admin/policy/{version}/activate


' ============================================================
' CONSENT REPRESENTATIONS
' ============================================================

rectangle "<<Representation>>\nPolicyResponseDto\n- id\n- content\n- version\n- isActive\n- createdAt" as PolicyResponseDto
GetCurrentPolicy --> PolicyResponseDto : <<use>>
GetPolicyByVersion --> PolicyResponseDto : <<use>>

rectangle "<<Representation>>\nConsentCheckResponseDto\n- needsConsent\n- latestVersion\n- userAcceptedVersion" as ConsentCheckResponseDto
CheckConsent --> ConsentCheckResponseDto : <<use>>

rectangle "<<Representation>>\nAcceptConsentResponseDto\n- message\n- acceptedVersion" as AcceptConsentResponseDto
AcceptConsent --> AcceptConsentResponseDto : <<use>>

rectangle "<<Representation>>\nCreatePolicyResponseDto\n- id\n- version\n- message" as CreatePolicyResponseDto
CreatePolicy --> CreatePolicyResponseDto : <<use>>

rectangle "<<Representation>>\nPolicyHistoryResponseDto\n- policies[]" as PolicyHistoryResponseDto
PolicyHistory --> PolicyHistoryResponseDto : <<use>>

rectangle "<<Representation>>\nUpdatePolicyResponseDto\n- message\n- updatedVersion" as UpdatePolicyResponseDto
UpdatePolicy --> UpdatePolicyResponseDto : <<use>>

rectangle "<<Representation>>\nDeletePolicyResponseDto\n- message" as DeletePolicyResponseDto
DeletePolicy --> DeletePolicyResponseDto : <<use>>

rectangle "<<Representation>>\nActivatePolicyResponseDto\n- message\n- activatedVersion" as ActivatePolicyResponseDto
ActivatePolicy --> ActivatePolicyResponseDto : <<use>>


' =============================
' EVENT RESOURCES / PATHS
' =============================

rectangle "<<Resource>>\nEvents\n+ GET\n+ POST" as Events
App --> Events : <<path>> /events

rectangle "<<Resource>>\nEventsWithImage\n+ POST" as EventsWithImage
Events --> EventsWithImage : <<path>> /withImage

rectangle "<<Resource>>\nEvent\n+ GET\n+ PATCH\n+ DELETE" as Event
Events --> Event : <<path>> /{id}

rectangle "<<Resource>>\nEventWithImage\n+ PATCH" as EventWithImage
Events --> EventWithImage : <<path>> /withImage/{id}

rectangle "<<Resource>>\nJoinEvent\n+ POST\n+ DELETE" as JoinEvent
Event --> JoinEvent : <<path>> /join

rectangle "<<Resource>>\nUserJoinedEvents\n+ GET" as UserJoinedEvents
Events --> UserJoinedEvents : <<path>> /user/joined

rectangle "<<Resource>>\nEventOrganizer\n+ GET" as EventOrganizer
Event --> EventOrganizer : <<path>> /organizer


' =============================
' EVENT REPRESENTATIONS
' =============================

rectangle "<<Representation>>\nEvent\n- eventId\n- cost\n- name\n- date\n- time\n- place\n- capacity\n- detail\n- rating\n- categories[]\n- imagePath\n- status\n- userId" as EventModel

Event --> EventModel : <<use>>
Events --> EventModel : <<use>>
EventsWithImage --> EventModel : <<use>>
EventWithImage --> EventModel : <<use>>

rectangle "<<Representation>>\nEventWithParticipants\n- eventId\n- cost\n- name\n- date\n- time\n- place\n- capacity\n- detail\n- rating\n- categories[]\n- imagePath\n- status\n- userId\n- currentParticipants" as EventWithParticipants

Event --> EventWithParticipants : <<use>>
Events --> EventWithParticipants : <<use>>
UserJoinedEvents --> EventWithParticipants : <<use>>

rectangle "<<Representation>>\nJoinResponse\n- message" as JoinResponse
JoinEvent --> JoinResponse : <<use>>


' ---- Organizer response (User) (FIXED) ----
rectangle "<<Representation>>\nUser\n- userId\n- firstName\n- lastName\n- email\n- role\n- profilePicture" as UserModel

EventOrganizer --> UserModel : <<use>>

' =============================
' UPLOAD RESOURCES
' =============================

rectangle "<<Resource>>\nUploadSingleFile\n+ POST" as UploadSingleFile
App --> UploadSingleFile : <<path>> /upload/upload_single_file

' =============================
' UPLOAD REPRESENTATIONS
' =============================

rectangle "<<Representation>>\nUploadResponse\n- filename\n- url" as UploadResponse
UploadSingleFile --> UploadResponse : <<use>>

' ============================================================
' USERS MODULE
' ============================================================

rectangle "<<Resource>>\nUsers\n+ GET" as Users
App --> Users : <<path>> /users

rectangle "<<Resource>>\nUser\n+ GET\n+ DELETE" as User
Users --> User : <<path>> /me  'delete uses /me

rectangle "<<Resource>>\nUserById\n+ GET" as UserById
Users --> UserById : <<path>> /{id}

rectangle "<<Resource>>\nEditUser\n+ PATCH" as EditUser
Users --> EditUser : <<path>> /edit

rectangle "<<Resource>>\nUploadProfilePicture\n+ POST" as UploadProfilePicture
Users --> UploadProfilePicture : <<path>> /profile-picture


' --- Representations ---

rectangle "<<Representation>>\nUserResponseDto\n- userId\n- firstName\n- lastName\n- email\n- role\n- profilePicture" as UserResponseDto

Users --> UserResponseDto : <<use>>
User --> UserResponseDto : <<use>>
UserById --> UserResponseDto : <<use>>
EditUser --> UserResponseDto : <<use>>

' Profile picture upload returns a user too
UploadProfilePicture --> UserResponseDto : <<use>>


@enduml
